<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="8dp"
        android:paddingEnd="22dp">

        <CheckBox android:id="@+id/cbDewarp" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="휨·구부림 보정 (휘어진 글줄을 곧게)" />
        <CheckBox android:id="@+id/cbFlatten" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="구김·그림자·책 안쪽 어두움 제거" />
        <CheckBox android:id="@+id/cbInk" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="컬러 펜·형광펜 필기 제거" />
        <CheckBox android:id="@+id/cbUnderline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="밑줄 제거 (연필·검정펜 포함)" />
        <CheckBox android:id="@+id/cbMargin" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="여백 메모 제거 (본문 밖을 지움 · 쪽번호도 지워질 수 있음)" />
        <CheckBox android:id="@+id/cbSplit" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="양면 펼침을 두 페이지로 분리" />
        <CheckBox android:id="@+id/cbCrop" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="불러온 사진에서 페이지 자동 검출·원근 보정" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="출력 색상"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/rbColor" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="컬러" />
            <RadioButton android:id="@+id/rbGray" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="회색조" />
            <RadioButton android:id="@+id/rbBw" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="선명한 흑백" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:text="※ 컬러 필기 제거는 컬러 그림·사진도 하얗게 지울 수 있습니다. 컬러 삽화가 있는 책은 끄세요."
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
